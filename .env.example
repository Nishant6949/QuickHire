# QuickHire local configuration
# Local development works without DATABASE_URL by falling back to SQLite.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=

# Optional: enables Claude-based semantic JD/resume analysis.
# Without it, QuickHire uses its built-in local screening fallback.
ANTHROPIC_API_KEY=

# Optional: Gmail SMTP. Without these, emails are previewed in the terminal.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_MODE=console

# Optional: Supabase Storage for retaining original uploaded PDFs.
SUPABASE_URL=
SUPABASE_KEY=
ENABLE_SUPABASE_STORAGE=false

# Runtime tuning
FLASK_ENV=development
SCREENING_BATCH_SIZE=5
RESUME_PARSE_MAX_PAGES=10
RESUME_PARSE_MAX_CHARS=50000
